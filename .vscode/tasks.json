{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    //
    // All tasks are plain POSIX shell commands. On Windows they are routed
    // through Git Bash (see the "windows" block below), so the same command
    // line works on macOS, Linux and Windows without per-OS overrides.
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "windows": {
        "options": {
            "shell": {
                "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
                "args": [
                    "-l",
                    "-c"
                ]
            }
        }
    },
    "presentation": {
        "reveal": "always",
        "panel": "shared"
    },
    "tasks": [
        {
            "label": "unix2dos src",
            "type": "shell",
            "command": "find src -type f \\( -name '*.cls' -o -name '*.bas' \\) -print0 | xargs -0 unix2dos",
            "problemMatcher": []
        },
        {
            "label": "update designer dev",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_designer('dev')\"",
            "problemMatcher": []
        },
        {
            "label": "update designer main",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_designer('main')\"",
            "problemMatcher": []
        },
        {
            "label": "update setup dev",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_setup('mock')\"",
            "problemMatcher": []
        },
        {
            "label": "update setup main",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_setup('main')\"",
            "problemMatcher": []
        },
        {
            "label": "update master setup dev",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_master_setup('mock')\"",
            "problemMatcher": []
        },
        {
            "label": "update master setup main",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_master_setup('main')\"",
            "problemMatcher": []
        },
        {
            "label": "update unit test",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_unit_test()\"",
            "problemMatcher": []
        },
        {
            "label": "Docs: Build full site",
            "type": "shell",
            "command": "bash scripts/docs/build-docs.sh",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Docs: Generate class markdown",
            "type": "shell",
            "command": "Rscript scripts/docs/create-docs.R class '${input:docClassName}'",
            "problemMatcher": []
        },
        {
            "label": "translations: merge designer",
            "type": "shell",
            "command": "Rscript scripts/devtools/match-designertranslations.R",
            "problemMatcher": []
        },
        {
            "label": "translations: coverage report",
            "type": "shell",
            "command": "Rscript scripts/devtools/translation-coverage.R",
            "problemMatcher": []
        },
        {
            "label": "translations: add rows",
            "type": "shell",
            "command": "Rscript scripts/devtools/add-translation-rows.R --workbook '${input:tradWorkbook}' --rows '${input:tradRows}'",
            "problemMatcher": []
        },
        {
            "label": "tests: build manual tests workbook",
            "type": "shell",
            "command": "Rscript scripts/devtools/build-manual-tests.R",
            "problemMatcher": []
        },
        {
            "label": "tests: narrow registry",
            "type": "shell",
            "command": "Rscript scripts/devtools/narrow-registry.R '${input:registryFolders}'",
            "problemMatcher": []
        },
        {
            "label": "tests: probe folders",
            "type": "shell",
            "command": "bash scripts/devtools/probe-folders.sh ${input:probeFolders}",
            "problemMatcher": []
        },
        {
            "label": "scan: name shadowing",
            "type": "shell",
            "command": "Rscript scripts/devtools/name-shadowing-scan.R",
            "problemMatcher": []
        },
        {
            "label": "scan: call signatures",
            "type": "shell",
            "command": "Rscript scripts/devtools/call-signature-scan.R --tests",
            "problemMatcher": []
        },
        {
            "label": "scan: linelist components",
            "type": "shell",
            "command": "Rscript scripts/devtools/linelist-components-scan.R",
            "problemMatcher": []
        },
        {
            "label": "scan: transferred code",
            "type": "shell",
            "command": "Rscript scripts/devtools/transferred-code-scan.R",
            "problemMatcher": []
        },
        {
            "label": "scan: interface guard",
            "type": "shell",
            "command": "bash scripts/devtools/interface-guard.sh",
            "problemMatcher": []
        },
        {
            "label": "scan: mock import drift",
            "type": "shell",
            "command": "bash scripts/devtools/mock-import-drift.sh ${input:driftTarget}",
            "problemMatcher": []
        },
        {
            "label": "comments: harvest",
            "type": "shell",
            "command": "Rscript scripts/devtools/harvest-comments.R",
            "problemMatcher": []
        },
        {
            "label": "comments: update (dry run)",
            "type": "shell",
            "command": "Rscript scripts/devtools/update-comments.R --input all-comments.txt --dry-run",
            "problemMatcher": []
        },
        {
            "label": "comments: update",
            "type": "shell",
            "command": "Rscript scripts/devtools/update-comments.R --input all-comments.txt",
            "problemMatcher": []
        },
        {
            "label": "ribbon: doctor",
            "type": "shell",
            "command": "bash scripts/devtools/ribbon-doctor.sh '${input:ribbonWorkbook}'",
            "problemMatcher": []
        },
        {
            "label": "ribbon: extract",
            "type": "shell",
            "command": "bash scripts/devtools/ribbon-extract.sh '${input:ribbonWorkbook}'",
            "problemMatcher": []
        },
        {
            "label": "ribbon: pack",
            "type": "shell",
            "command": "bash scripts/devtools/ribbon-pack.sh '${input:ribbonDir}' --out '${input:ribbonOut}' --overwrite",
            "problemMatcher": []
        },
        {
            "label": "ribbon: envelope (2007)",
            "type": "shell",
            "command": "bash scripts/devtools/ribbon-envelope.sh '${input:ribbonWorkbook}'",
            "problemMatcher": []
        },
        {
            "label": "inspect: linelist",
            "type": "shell",
            "command": "Rscript scripts/devtools/linelist-inspect.R '${input:linelistPath}'",
            "problemMatcher": []
        },
        {
            "label": "inspect: vba project",
            "type": "shell",
            "command": "Rscript scripts/devtools/vba-inspect.R '${input:vbaBinPath}' ${input:vbaMode} src",
            "problemMatcher": []
        },
        {
            "label": "names: show folder",
            "type": "shell",
            "command": "bash scripts/devtools/show-names.sh ${input:namesKind} ${input:namesArgs}",
            "problemMatcher": []
        },
        {
            "label": "tests: run suite (background)",
            "type": "shell",
            "command": "bash scripts/tests/run-tests-bg.sh --build",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "tests: run suite (background, with options)",
            "type": "shell",
            "command": "bash scripts/tests/run-tests-bg.sh ${input:testRunArgs}",
            "problemMatcher": []
        },
        {
            "label": "headless: build linelist",
            "type": "shell",
            "command": "bash scripts/headless/build-linelist.sh",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "headless: build linelist (with options)",
            "type": "shell",
            "command": "bash scripts/headless/build-linelist.sh ${input:headlessArgs}",
            "problemMatcher": []
        },
        {
            "label": "release: push assets",
            "type": "shell",
            "command": "bash scripts/release/push-assets.sh",
            "problemMatcher": []
        },
        {
            "label": "release: push assets (no dev refresh)",
            "type": "shell",
            "command": "OBT_SKIP_DEV_REFRESH=1 bash scripts/release/push-assets.sh",
            "problemMatcher": []
        },
        {
            "label": "release: pull assets",
            "type": "shell",
            "command": "bash scripts/release/pull-assets.sh",
            "problemMatcher": []
        },
        {
            "label": "release: build zip",
            "type": "shell",
            "command": "bash scripts/release/build-release-zip.sh ${input:releaseBranch} '${input:releaseVersion}'",
            "problemMatcher": []
        },
        {
            "label": "release: build site releases page",
            "type": "shell",
            "command": "bash scripts/ci/build-releases.sh",
            "problemMatcher": []
        },
        {
            "label": "release: backfill legacy (dry run)",
            "type": "shell",
            "command": "DRY_RUN=yes bash scripts/release/backfill-legacy.sh",
            "problemMatcher": []
        },
        {
            "label": "release: backfill legacy",
            "type": "shell",
            "command": "bash scripts/release/backfill-legacy.sh",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "docClassName",
            "type": "promptString",
            "description": "Class or interface name to document (without the .cls extension)"
        },
        {
            "id": "tradWorkbook",
            "type": "promptString",
            "description": "Translations workbook to grow",
            "default": "trads/designer_translations.xlsx"
        },
        {
            "id": "tradRows",
            "type": "promptString",
            "description": "CSV of rows to add (first column = table name, then the row starting with the message code)",
            "default": "trads/new-rows.csv"
        },
        {
            "id": "registryFolders",
            "type": "promptString",
            "description": "Suite folder(s) to keep in the registry, comma separated (e.g. dataio,helpers)"
        },
        {
            "id": "probeFolders",
            "type": "promptString",
            "description": "Folders to probe one at a time, space separated; empty walks every registry folder except helpers",
            "default": ""
        },
        {
            "id": "driftTarget",
            "type": "pickString",
            "description": "Which mock workbook(s) to check against the source files",
            "options": [
                "all",
                "setup",
                "designer",
                "unit_test",
                "mastersetup"
            ],
            "default": "all"
        },
        {
            "id": "ribbonWorkbook",
            "type": "promptString",
            "description": "Workbook carrying the ribbon (e.g. .mock/setup_mock.xlsb)",
            "default": ".mock/setup_mock.xlsb"
        },
        {
            "id": "ribbonDir",
            "type": "promptString",
            "description": "Ribbon folder produced by ribbon-extract.sh (e.g. ribbons/setup_mock)",
            "default": "ribbons/setup_mock"
        },
        {
            "id": "ribbonOut",
            "type": "promptString",
            "description": "Workbook to write the packed ribbon into (overwritten)",
            "default": ".mock/setup_mock.xlsb"
        },
        {
            "id": "linelistPath",
            "type": "promptString",
            "description": "Delivered linelist to inspect (.xlsb)"
        },
        {
            "id": "vbaBinPath",
            "type": "promptString",
            "description": "Path to the vbaProject.bin to read"
        },
        {
            "id": "vbaMode",
            "type": "pickString",
            "description": "list = name the components; content = also compare their source with src/",
            "options": [
                "list",
                "content"
            ],
            "default": "list"
        },
        {
            "id": "namesKind",
            "type": "pickString",
            "description": "Which source tree to list",
            "options": [
                "--classes",
                "--modules",
                "--tests"
            ],
            "default": "--classes"
        },
        {
            "id": "namesArgs",
            "type": "promptString",
            "description": "Extra arguments: --folder=<name>, --folders, --ext, --paths; empty lists every name in the tree",
            "default": "--folder=dataio"
        },
        {
            "id": "testRunArgs",
            "type": "promptString",
            "description": "Flags for run-tests-bg.sh: --build (import the sources first), --wait (block until the run ends), --keep, --home=<dir>",
            "default": "--build --wait"
        },
        {
            "id": "headlessArgs",
            "type": "promptString",
            "description": "Overrides for build-linelist.sh, e.g. --setup=<file> --out=<dir> --name=<stem>; --help lists them all",
            "default": "--help"
        },
        {
            "id": "releaseBranch",
            "type": "pickString",
            "description": "Which stream to package: main ships the promoted binaries, dev the _dev ones",
            "options": [
                "main",
                "dev"
            ],
            "default": "dev"
        },
        {
            "id": "releaseVersion",
            "type": "promptString",
            "description": "Version stamped on the archive: a semantic version for main (e.g. 2.0.0), 'latest' for dev",
            "default": "latest"
        }
    ]
}
