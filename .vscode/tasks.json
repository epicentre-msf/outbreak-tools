{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    //
    // All tasks are plain POSIX shell commands. On Windows they are routed
    // through Git Bash (see the "windows" block below), so the same command
    // line works on macOS, Linux and Windows without per-OS overrides.
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "windows": {
        "options": {
            "shell": {
                "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
                "args": [
                    "-l",
                    "-c"
                ]
            }
        }
    },
    "presentation": {
        "reveal": "always",
        "panel": "shared"
    },
    "tasks": [
        {
            "label": "unix2dos src",
            "type": "shell",
            "command": "find src -type f \\( -name '*.cls' -o -name '*.bas' \\) -print0 | xargs -0 unix2dos",
            "problemMatcher": []
        },
        {
            "label": "update designer dev",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_designer('dev')\"",
            "problemMatcher": []
        },
        {
            "label": "update designer main",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_designer('main')\"",
            "problemMatcher": []
        },
        {
            "label": "update setup dev",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_setup('mock')\"",
            "problemMatcher": []
        },
        {
            "label": "update setup main",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_setup('main')\"",
            "problemMatcher": []
        },
        {
            "label": "update master setup dev",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_master_setup('mock')\"",
            "problemMatcher": []
        },
        {
            "label": "update master setup main",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_master_setup('main')\"",
            "problemMatcher": []
        },
        {
            "label": "update unit test",
            "type": "shell",
            "command": "Rscript -e \"source('scripts/devtools/update-files.R'); update_unit_test()\"",
            "problemMatcher": []
        },
        {
            "label": "Docs: Build full site",
            "type": "shell",
            "command": "bash scripts/docs/build-docs.sh",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Docs: Generate class markdown",
            "type": "shell",
            "command": "Rscript scripts/docs/create-docs.R class '${input:docClassName}'",
            "problemMatcher": []
        },
        {
            "label": "translations: merge designer",
            "type": "shell",
            "command": "Rscript scripts/devtools/match-designertranslations.R",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "docClassName",
            "type": "promptString",
            "description": "Class or interface name to document (without the .cls extension)"
        }
    ]
}
