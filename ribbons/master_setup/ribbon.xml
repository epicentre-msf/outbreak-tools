<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad = "ribbonLoaded">
    <ribbon startFromScratch="false">
        <tabs>
            <tab id="customTab" label="OutbreakTools">
                <group id="customGroupManage" label="Manage">
                    <button id="btnAdd" label="Add Rows" imageMso="QueryShowTable" size="large" onAction="clickAddRows"/>
                    <button id="btnRes" label="Resize Tables" imageMso="SheetRowsDelete" size="large" onAction="clickResize"/>
                    <button id="btnFilt" label="Clear Filters" imageMso="FilterClearAllFilters" size="large" onAction="clickFilters"/>
                    <button id="btnSortTab" label="Sort Tables" image="sort" size="large" onAction="clickRibbonSortTable"/>
                    <button id="btnMsImpPass" label="Import Passwords" image="password" size="large" onAction="clickMsImpPass"/>
                </group>
                <group id="customGroupDisease" label="Diseases">
                    <button id="btnAddSheet" label="New Disease" image="addsheet" size="large" onAction="clickAddSheet"/>
                    <button id="btnRemSheet" label="Remove Disease" imageMso="ClearGrid" size="large" onAction="clickRemSheet"/>
                    <button id="btnClear" label="Clear Disease" imageMso="ClearAll" size="large" onAction="clickClearSheet"/>
                </group>
                <group id="customGroupTrans" label="Translations">
                    <button id="btnTransAdd" image="translation" label="Update Translations" size="large" onAction="clickAddTrans"/>
                    <editBox id="editLang" label="Add Language" imageMso="translationPane" onChange="clickAddLang"/>
                    <editBox id="editRemLang" label="Remove Language" imageMso="Delete" onChange="clickRemLang"/>
                </group>
                <group id="customGroupAdv" label="Exports">
                    <button id="btnExp" label="Export To Setup" image="anaexport" size="large" onAction="clickExpSheet"/>
                    <button id="btnExpMig" label="Export For Migration" imageMso="GridSettings" size="normal" onAction="clickExp"/>
                    <button id="btnImpMig" label="Import Migration File" imageMso="GridSettings" size="normal" onAction="clickImp"/>
                </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>
