<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad = "OnRibbonLoad">
    <ribbon startFromScratch="false">
        <tabs>
            <tab id="customTab" label="OutbreakTools">
                <group id="customGroupManage" label="Manage">
                    <button id="btnAdd" label="Add Rows" imageMso="QueryShowTable" size="large" onAction="clickAddRows"/>
                    <button id="btnRes" label="Resize Tables" imageMso="SheetRowsDelete" size="large" onAction="clickResize"/>
                    <button id="btnFilt" label="Clear Filters" imageMso="FilterClearAllFilters" size="large" onAction="clickFilters"/>
                    <button id="btnSortTab" label="Sort Tables" image="sort" size="large" onAction="clickRibbonSortTable"/>
                    <button id="btnRefChoices" label="Refresh Choices" imageMso="RefreshAll" size="large" onAction="clickRefreshChoices"/>
                    <button id="btnMsImpPass" label="Import Passwords" image="password" size="large" onAction="clickMsImpPass"/>
                </group>
                <group id="customGroupDisease" label="Diseases">
                    <button id="btnAddSheet" label="New Disease" image="addsheet" size="large" onAction="clickAddSheet"/>
                    <button id="btnRemSheet" label="Remove Disease" imageMso="ClearGrid" size="normal" onAction="clickRemSheet"/>
                    <button id="btnClear" label="Clear Disease" imageMso="ClearAll" size="normal" onAction="clickClearSheet"/>
                    <button id="btnCompare" label="Compare Diseases" imageMso="ReviewCompareTwoVersions" size="normal" onAction="clickCompare"/>
                </group>
                <group id="customGroupTrans" label="Translations">
                    <button id="btnTransAdd" image="translation" label="Update Translations" size="large" onAction="clickAddTrans"/>
                    <editBox id="editLang" label="Add Language" imageMso="translationPane" onChange="clickAddLang"/>
                    <editBox id="editRemLang" label="Remove Language" imageMso="Delete" onChange="clickRemLang"/>
                    <button id="btnTagUpdate" label="Reset Translation Tags" image="headertag" size="normal" onAction="clickResetTags"/>
                </group>
                <group id="customGroupAdv" label="Exports">
                    <button id="btnExp" label="Export To Setup" image="anaexport" size="large" onAction="clickExpSheet"/>
                    <button id="btnImpSheet" label="Import From Setup" image="download" size="large" onAction="clickImpSheet"/>
                    <button id="btnExpMig" label="Export For Migration" imageMso="GridSettings" size="normal" onAction="clickExp"/>
                    <button id="btnImpMig" label="Import Migration File" imageMso="GridSettings" size="normal" onAction="clickImp"/>
                </group>
                <group id="customGroupLog" label="Log">
                    <button id="btnOpenLog" label="Open Log" imageMso="ErrorChecking" size="large" onAction="clickOpenLog"/>
                    <button id="btnExpLog" label="Export Log" imageMso="FileSaveAsOtherFormats" size="large" onAction="clickExportLog"/>
                </group>
                <group id="customGroupDev" label="Dev" getVisible="DevGroupVisible">
                    <button id="btnInit" label="Initialize" image="initialise" size="large" onAction="clickDevInitialize"/>
                    <button id="btnFolder" label="Codes Folder" image="folder" size="large" onAction="clickDevFolder"/>
                    <button id="btnImpCodes" label="Import Codes" image="upload2" size="large" onAction="clickDevImport"/>
                    <button id="btnExpCodes" label="Export Codes" image="download2" size="large" onAction="clickDevExport"/>
                    <button id="btnVBEE" label="Open Editor" image="settings2" size="large" onAction="clickDevVBE"/>
                    <button id="btnDeploy" label="Deploy" image="rocketlaunch" size="large" onAction="clickDevDeploy"/>
                    <button id="btnAddRowsDev" label="AddRows to tables" image="addrowsdev" size ="normal" onAction="clickDevAddRows"/>
                    <button id="btnResDev" label="Resize tables" image = "resizedev" size = "normal" onAction="clickDevResize"/>
                    <button id="btnAddFormsDev" label="Add forms codes" image = "addformscodedev" size="normal" onAction="clickDevAddFormsCodes"/>
                    <button id="btnAddTabClass" label="Add class table" image ="addclassdev" size="normal" onAction="clickDevAddClassTable"/>
                    <button id="btnAddTabForm" label="Add Form table" image="addformsdev" size="normal" onAction="clickDevAddFormTable"/>
                    <button id="btnAddTabMods" label="Add Modules table" image="addmodsdev" size="normal" onAction="clickDevAddModulesTable"/>
                </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>
